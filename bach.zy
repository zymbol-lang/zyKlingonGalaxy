//  () —     veS  (CSUR PUA —   )
//  ,  je   .
//
//   (  —   ):
//   (fila, col)
//         (fila -= 1 ).
//        (fila += 1 ); MAX_BOLTS .
//
//   (Daq):  ;    DaH.
//   (↑):         MAX_RAP ;    Daq.
//
//  :
//   vIH_mIwDu        —   vs   je  
//   vIH_mIwDu_rap    —   vs   je  
//   vIH_jagh_bachDu  —   vs  ( )
//
//  ( ;     Daq):
//    0    →  
//    1    →  
//    2  →  

# bach {
    #> { , _, __, _, __ }

    _c() {
        <~ ( *  + ) % 
    }

    _(, , ) {
         = _c()
        <~ ( % ( -  + ) + , )
    }

    __() {
        ?  ==  { <~  }
        ?  ==  { <~  }
        <~ 
    }

    //      Daq
    __(, ) {
         = []
         = 
        @:_ {
            ?  > $# { @:_! }
            ?  <>  {  =  $+ [] }
             =  + 
        }
        <~ 
    }

    //    Daq (, c) —  DaH ().
    // <~ (, , )
    __c(, , c) {
         = 
        @:_ {
            ?  > $# { @:_! }
            [, c, , ] = []
            ?  ==  && c == c {
                <~ (__(, ), #, )
            }
             =  + 
        }
        <~ (, #, )
    }

    //    Daq (, c) —  ( ).
    // <~ (, c, , , )
    //   c = #   (  )
    //       = #  
    //      = [(, c, , )]  ach , [] 
    __c_(, , c) {
         = 
        @:_ {
            ?  > $# { @:_! }
            [, c, , ] = []
            ?  ==  && c == c {
                 =  - 
                ?  <=  {
                    <~ (__(, ), #, #, , [])
                }
                //  ach  — naQ HP 
                 = []
                 = 
                @: {
                    ?  > $# { @:! }
                    ?  ==  {  =  $+ (, c, , ) }
                    ?  <>  {  =  $+ [] }
                     =  + 
                }
                <~ (, #, #, , [(, c, , )])
            }
             =  + 
        }
        <~ (, #, #, , [])
    }

    //    Daq (, c) —  DaH (  ).
    // <~ (, , , _)
    __(, , c) {
         = 
        @:_ {
            ?  > $# { @:_! }
            [, c, , , c] = []
            ?  ==  && c == c {
                <~ (__(, ), #, , (, c, ))
            }
             =  + 
        }
        <~ (, #, , (, , ))
    }

    // ─────────────────────────────────────────────────────────────────────────
    // API 
    // ─────────────────────────────────────────────────────────────────────────

    //  chu'  (, c) —  je   .
    (, , c) {
        <~  $+ (, c)
    }

    //      (+);  .
    //
    // <~ (, , , , , ):
    //    — #   DaH
    //        —   Daq
    //      — [(, c, ), ...]   Daq (+)
    _(, , , , ) {
        [, c, ] = 
            = 
          = []
         = []

         = 
        @:_ {
            ?  > $# { @:_! }
            [, c] = []
                =  - 
             = #

            [, , ] = __c(, , c)
            ?  {
                   =  + __()
                 =  $+ (, c, )
            }

            ? ! {
                [, , , _] = __(, , c)
                ?  {
                       =  + __() * 
                     =  $+ _
                }
            }

            ? ! &&  >=  {  =  $+ (, c) }

             =  + 
        }

         = #
        ? $# >  {  = # }

         = (, c, )
        <~ (, , , , , )
    }

    //      (+);  .
    //
    // <~ (_, , , , _, ):
    //   _ — [(, c, ), ...]    Daq ( +)
    //      — [(, c, , ), ...]   ach  (glyph)
    __(_, , , ) {
        [, c, ] = 
                = 
        _  = []
            = []
             = []
        _    = #    // pre-declare for write-through inside ? block
        _     = 
        _      = (, , )
        _    = 

         = 
        @:_ {
            ?  > _$# { @:_! }
            [, c] = _[]
                  =  - 
            _ = #    // reset each iteration

            [, c, , , ] = __c_(, , c)
            ?  {
                       =  + __()
                _ = _ $+ (, c, )
            }
            ? ! && $# >  {
                 =  $+ []
            }

            ? !c {
                [, _, _, _] = __(, , c)
                ? _ {
                           =  + __(_) * 
                    _ = _ $+ _
                }
            }

            ? !c && !_ &&  >=  {  =  $+ (, c) }

             =  + 
        }

         = (, c, )
        <~ (, , , , _, )
    }

    //   Hap  DaH;  nIS  .
    // <~ (_, )
    _(_, , , , , ) {
        _ = 
        ? _$# >= _ { <~ (_, ) }

        [, c, ] = 
         = $# + $#
        ?  ==  { <~ (_, ) }

         =  +  * 
        ?  >  {  =  }
        [, ] = _(, , )
        ?  >  { <~ (_, ) }

        //     ; Hov  choH
         =  - 
        ?  <  {  =  }
         = 
        ?  >  {
            [, ] = _(, ,  * )
             =  +  - 
        }

        //   ;   Hov
        c = 
         = 
         = 
         = 
        @:_ {
            ?  >  { @:_! }
            ?  <= $# { [, c, , ] = [] }
            ?  > $# {
                 =  - $#
                [, c, , , c] = []
            }
             = c - 
            ?  <  {  = - }
            ?  <  {
                 = 
                 = 
            }
             =  + 
        }

        ?  <= $# {
            [, c, , ] = []
            _ = _ $+ ( + , c)
        }
        ?  > $# {
             =  - $#
            [, c, , , c] = []
            _ = _ $+ ( + , c)
        }
        <~ (_, )
    }

    //      (+);   .
    //     ( ); DaH  0 .
    // <~ (_, _, c_c, c_c)
    __(_, , _, , , c_c, c_c) {
            = []
        _   = #
        _ = #    // pre-declare for write-through

         = 
        @:_ {
            ?  > _$# { @:_! }
            [, c] = _[]
                    =  + 
            _ = #

            ?  == _ && c ==  {
                ? c_c && c_c >  { _ = # }
                ? _ {
                    c_c  = c_c - 
                    c_c = #    // always deactivate after absorbing  hit
                }
                ? !_ { _ = # }
                //   — naQ Daq +
            }
            ?  <=  +  && ( <> _ || c <> ) {
                 =  $+ (, c)
            }

             =  + 
        }

        <~ (, _, c_c, c_c)
    }
}
