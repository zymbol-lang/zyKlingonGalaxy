//  () —      (CSUR PUA —   )
// >>~   —  , <~ 
//  _ (<~ )  _ (<~ 'n'/'s')
//
// ANSI 256  :
//   =8  =15  =46  _=51  =51  _=226
//   =214  =208  =220  =196  =196  =226
//   =11  =10  =14  =51

#  {
    #> {
        _,
        _, _, _, _, c_,
        _, _,
        , _, _, _,
        _, _
    }

    __() {
        <~ "─" $* 
    }

    //   HP —  
    __(, ) {
        ?  ==  { ?  >=  { <~ "◆" } <~ "◇" }
        ?  ==  { ?  >=  { <~ "▼" } <~ "△" }
        <~ "▽"
    }

    //   — 
    _c_() {
        ?  ==  { <~  }
        ?  ==  { <~  }
        <~ 
    }

    //  :  → ,  → 
    _c_(c_c) {
        ? c_c { <~  }
        <~ 
    }
    //  →  (U+F8F0–F8F9)
    __() {
        ?  ==  { <~ "" }
           = ""
        dch = ""
        @:_ {
            ?  ==  { @:_! }
               =  % 
             = ""
            ?  ==  {  = "" }
            ?  ==  {  = "" }
            ?  ==  {  = "" }
            ?  ==  {  = "" }
            ?  ==  {  = "" }
            ?  ==  {  = "" }
            ?  ==  {  = "" }
            ?  ==  {  = "" }
            ?  ==  {  = "" }
             =  $+ 
             =  / 
        }
        <~ 
    }


    __(c, , ) {
        ? c == '↑' { ?  >    { <~  -  } <~  }
        ? c == '↓' { ?  <  { <~  +  } <~    }
        <~ 
    }

    // ──   +   ─────────────────────────────────
    _(, , ) {
        >>!
        _c =  /  - 
        c_c  =  /  - 
            = 

        @:_ {
            >>~ (_c,    c_c, , ) > "╭────────────────────────────────╮"
            >>~ (_c+,  c_c, , ) > "│                         │"
            ?  ==  { >>~ (_c+ , c_c, , ) > "│         H O V   V E S          │" }
            ?  ==  { >>~ (_c+ , c_c, , ) > "│         H O V   V E S          │" }
            >>~ (_c+,  c_c, , ) > "│                       │"
            ?  ==  { >>~ (_c+ , c_c, , ) > "│       IKS  meQtaH              │" }
            ?  ==  { >>~ (_c+ , c_c, , ) > "│       IKS  meQtaH              │" }
            >>~ (_c+,  c_c, , ) > "│               │"
            ?  ==  { >>~ (_c+ , c_c, , ) > "│  B'rel Bird-of-Prey vs Armada  │" }
            ?  ==  { >>~ (_c+ , c_c, , ) > "│  B'rel Bird-of-Prey vs Armada  │" }
            >>~ (_c+,  c_c, ,  ) > "├────────────────────────────────┤"
            >>~ (_c+,  c_c, , ) > "│    :                     │"
            ?  ==  { >>~ (_c+,  c_c, , ) > "│   Select difficulty:           │" }
            ?  ==  { >>~ (_c+,  c_c, , ) > "│   Seleccionar dificultad:      │" }
            >>~ (_c+,  c_c, , ) > "│                                │"
            >>~ (_c+,  c_c, , ) > "│   []                │"
            ?  ==  { >>~ (_c+,  c_c, , ) > "│   [1]  petaQ    (easy)  120 ms │" }
            ?  ==  { >>~ (_c+,  c_c, , ) > "│   [1]  petaQ    (fácil) 120 ms │" }
            >>~ (_c+,  c_c, , ) > "│   []             │"
            ?  ==  { >>~ (_c+,  c_c, , ) > "│   [2]  Hab SoSlI (med)   90 ms │" }
            ?  ==  { >>~ (_c+,  c_c, , ) > "│   [2]  Hab SoSlI (med)   90 ms │" }
            >>~ (_c+,  c_c, , ) > "│   []                │"
            ?  ==  { >>~ (_c+,  c_c, , ) > "│   [3]  Qapla'   (hard)   60 ms │" }
            ?  ==  { >>~ (_c+,  c_c, , ) > "│   [3]  Qapla'   (difíc)  60 ms │" }
            >>~ (_c+, c_c, , ) > "│   []                │"
            ?  ==  { >>~ (_c+, c_c, , ) > "│   [4]  Heghlu'  (death)  40 ms │" }
            ?  ==  { >>~ (_c+, c_c, , ) > "│   [4]  Heghlu'  (muerte) 40 ms │" }
            >>~ (_c+, c_c, ,  ) > "├────────────────────────────────┤"
            >>~ (_c+, c_c, , ) > "│  ↑↓ / - / ↵              │"
            ?  ==  { >>~ (_c+, c_c, , ) > "│  ↑↓ / 1-4 / ↵ to confirm      │" }
            ?  ==  { >>~ (_c+, c_c, , ) > "│  ↑↓ / 1-4 / ↵ confirmar       │" }
            >>~ (_c+, c_c, , ) > "│  Q =                     │"
            ?  ==  { >>~ (_c+, c_c, , ) > "│  Q = quit during game          │" }
            ?  ==  { >>~ (_c+, c_c, , ) > "│  Q = salir durante juego       │" }
            >>~ (_c+, c_c, , ) > "╰────────────────────────────────╯"

            ?  ==  { >>~ (_c+,  c_c, , ) > "│ ► []                │" }
            ?  ==  &&  ==  { >>~ (_c+,  c_c, , ) > "│ ► [1]  petaQ    (easy)  120 ms │" }
            ?  ==  &&  ==  { >>~ (_c+,  c_c, , ) > "│ ► [1]  petaQ    (fácil) 120 ms │" }
            ?  ==  { >>~ (_c+,  c_c, , ) > "│ ► []             │" }
            ?  ==  &&  ==  { >>~ (_c+,  c_c, , ) > "│ ► [2]  Hab SoSlI (med)   90 ms │" }
            ?  ==  &&  ==  { >>~ (_c+,  c_c, , ) > "│ ► [2]  Hab SoSlI (med)   90 ms │" }
            ?  ==  { >>~ (_c+,  c_c, , ) > "│ ► []                │" }
            ?  ==  &&  ==  { >>~ (_c+,  c_c, , ) > "│ ► [3]  Qapla'   (hard)   60 ms │" }
            ?  ==  &&  ==  { >>~ (_c+,  c_c, , ) > "│ ► [3]  Qapla'   (difíc)  60 ms │" }
            ?  ==  { >>~ (_c+, c_c, , ) > "│ ► []                │" }
            ?  ==  &&  ==  { >>~ (_c+, c_c, , ) > "│ ► [4]  Heghlu'  (death)  40 ms │" }
            ?  ==  &&  ==  { >>~ (_c+, c_c, , ) > "│ ► [4]  Heghlu'  (muerte) 40 ms │" }

            <<| c
            ? c == '1' { <~  }
            ? c == '2' { <~   }
            ? c == '3' { <~   }
            ? c == '4' { <~   }
            ? c == 'q' || c == 'Q' { <~  }
            ? c == '\n' {
                ?  ==  { <~  }
                ?  ==  { <~   }
                ?  ==  { <~   }
                ?  ==  { <~   }
            }
             = __(c, , )
        }
    }

    // ──   +  ─────────────────────────────────────────────────
    _(, ) {
        >>!
        >>~ (,      , , ) > "╭" __() "╮"
        >>~ ( + , , , ) > "╰" __() "╯"
         = 
        @  <=  +  {
            >>~ (, ,      , ) > "│"
            >>~ (,  + , , ) > "│"
            ++
        }
    }

    // ──   ─────────────────────────────────────────────────────────
    _(, , , ) {
        c_ = 
        >>~ (, c_, , ) > ": "
        ?  ==  { >>~ (, c_, , ) > "Lvs: " }
        ?  ==  { >>~ (, c_, , ) > "Vid: " }
        @ :1..3 {
            ?  <=  { >>~ (, c_ +  + ( - ) * , , ) > "♦" }
            ?  >   { >>~ (, c_ +  + ( - ) * , ,  ) > "·" }
        }
    }

    // ──    ───────────────────────────────────────────────
    // :" =   jIH
    c_(c_c, c_c, , ) {
        c_ = 
        c_ = 
        ? c_c { c_ =  }
        >>~ (, c_, , c_) > ":"
        ?  ==  { >>~ (, c_, , ) > "S:" }
        ?  ==  { >>~ (, c_, , ) > "E:" }
        @ :1..3 {
            ?  <= c_c { >>~ (, c_ +  + , , ) > "■" }
            ?  > c_c  { >>~ (, c_ +  + , ,  ) > "·" }
        }
    }

    // ──   ─────────────────────────────────────────────────────────
    _(, , ) {
        c_ =  /  - 
        >>~ (, c_,      ,  ) > "┤"
        >>~ (, c_ + ,  , ) > " : "
        ?  ==  { >>~ (, c_+, , ) > " Pts: " }
        ?  ==  { >>~ (, c_+, , ) > " Pts: " }
        >>~ (, c_ + ,  , ) > __() "   "
        >>~ (, c_ + , ,  ) > "├"
    }

    // ──   ─────────────────────────────────────────────────────────
    _(, , ) {
        c_ =  - 
        >>~ (, c_,     ,  ) > "┤"
        >>~ (, c_ + , , ) > " : "
        ?  ==  { >>~ (, c_+, , ) > " Wav: " }
        ?  ==  { >>~ (, c_+, , ) > " Ola: " }
        >>~ (, c_ + , , ) > __() " "
        >>~ (, c_ + , ,  ) > "├"
    }

    // ──    ────────────────────────────────────────────
    _(, , ) {
        [, c, ] = 
         = 
        @  <= $# {
            [, c, , ] = []
            >>~ (, c, , _c_()) > __(, )
            ++
        }
    }

    // ──   ─────────────────────────────────────────────────────────
    _(, _, , c_c) {
        >>~ (_, , , _c_(c_c)) > "▲"
    }

    // ──   ───────────────────────────────────────────────────────────
    (, , ) {
        _c =  /  - 
        c_c  =  /  - 

        >>~ (_c,   c_c, , ) > "╭───────────────────╮"
        >>~ (_c+, c_c, , ) > "│                   │"
        >>~ (_c+, c_c, , ) > "│     !          │"
        ?  ==  { >>~ (_c+, c_c, , ) > "│     PAUSE!         │" }
        ?  ==  { >>~ (_c+, c_c, , ) > "│     PAUSA!         │" }
        >>~ (_c+, c_c, , ) > "│   (    )       │"
        ?  ==  { >>~ (_c+, c_c, , ) > "│  (game paused)    │" }
        ?  ==  { >>~ (_c+, c_c, , ) > "│ (juego pausado)   │" }
        >>~ (_c+, c_c, , ) > "│  [P]         │"
        ?  ==  { >>~ (_c+, c_c, , ) > "│  [P]  resume      │" }
        ?  ==  { >>~ (_c+, c_c, , ) > "│  [P]  continuar   │" }
        >>~ (_c+, c_c, , ) > "╰───────────────────╯"

        @:_ {
            <<| c
            ? c == 'p' || c == 'P' { @:_! }
        }
    }

    // ──   () ─────────────────────────────────────────────
    _(, _, , ) {
        @ :1..3 {
            >>~ (_, , , ) > "✸"
            @~ 
            >>~ (_, , , ) > " "
            @~ 
        }
    }

    // ──    ──────────────────────────────────────────────────
    _(, , , , ) {
        _c =  /  - 
        c_c  =  /  - 

        >>~ (_c,   c_c, , ) > "╭───────────────────────────╮"
        >>~ (_c+, c_c, , ) > "│          !          │"
        ?  ==  { >>~ (_c+, c_c, , ) > "│          Qapla'!          │" }
        ?  ==  { >>~ (_c+, c_c, , ) > "│          Qapla'!          │" }
        >>~ (_c+, c_c, , ) > "│    " __() " !       │"
        ?  ==  { >>~ (_c+, c_c, , ) > "│   Wave "  " cleared!          │" }
        ?  ==  { >>~ (_c+, c_c, , ) > "│   Oleada "  " completada!       │" }
        >>~ (_c+, c_c, , ) > "│   : " __() "                │"
        ?  ==  { >>~ (_c+, c_c, , ) > "│   Score: "  "                │" }
        ?  ==  { >>~ (_c+, c_c, , ) > "│   Puntos: "  "               │" }
        >>~ (_c+, c_c, , ) > "╰───────────────────────────╯"
        @~ 
    }

    // ──    — <~ 'n'  , 's'  ────────
    _(, , , _, , , ) {
        _c =  /  - 
        c_c  =  /  - 
            = 

        @:_ {
            >>!
            >>~ (_c,   c_c, , ) > "╭───────────────────────────╮"
            >>~ (_c+, c_c, , ) > "│          !          │"
            ?  ==  { >>~ (_c+, c_c, , ) > "│         Heghlu'!          │" }
            ?  ==  { >>~ (_c+, c_c, , ) > "│         Heghlu'!          │" }
            >>~ (_c+, c_c, , ) > "│   ()              │"
            ?  ==  { >>~ (_c+, c_c, , ) > "│   (you have died)             │" }
            ?  ==  { >>~ (_c+, c_c, , ) > "│   (has muerto)                │" }
            >>~ (_c+, c_c, ,   ) > "├───────────────────────────┤"
            >>~ (_c+, c_c, ,  ) > "│  :   " __() "               │"
            ?  ==  { >>~ (_c+, c_c, ,  ) > "│  Score:  "  "               │" }
            ?  ==  { >>~ (_c+, c_c, ,  ) > "│  Puntos: "  "               │" }
            >>~ (_c+, c_c, ,  ) > "│  :    " __() "               │"
            ?  ==  { >>~ (_c+, c_c, ,  ) > "│  Wave:   "  "               │" }
            ?  ==  { >>~ (_c+, c_c, ,  ) > "│  Oleada: "  "               │" }
            >>~ (_c+, c_c, ,  ) > "│  :   " __() "               │"
            ?  ==  { >>~ (_c+, c_c, ,  ) > "│  Games:  "  "               │" }
            ?  ==  { >>~ (_c+, c_c, ,  ) > "│  Partidas:"  "              │" }
            >>~ (_c+, c_c, ,   ) > "├───────────────────────────┤"
            >>~ (_c+,  c_c, , ) > "│                     │"
            ?  ==  { >>~ (_c+,  c_c, , ) > "│  New game                   │" }
            ?  ==  { >>~ (_c+,  c_c, , ) > "│  Nueva partida               │" }
            >>~ (_c+,  c_c, , ) > "│                        │"
            ?  ==  { >>~ (_c+,  c_c, , ) > "│  Quit                        │" }
            ?  ==  { >>~ (_c+,  c_c, , ) > "│  Salir                       │" }
            >>~ (_c+, c_c, , ) > "╰───────────────────────────╯"

            ?  ==  { >>~ (_c+, c_c, , ) > "│►                    │" }
            ?  ==  &&  ==  { >>~ (_c+, c_c, , ) > "│► New game                   │" }
            ?  ==  &&  ==  { >>~ (_c+, c_c, , ) > "│► Nueva partida               │" }
            ?  ==  { >>~ (_c+, c_c, , ) > "│►                       │" }
            ?  ==  &&  ==  { >>~ (_c+, c_c, , ) > "│► Quit                        │" }
            ?  ==  &&  ==  { >>~ (_c+, c_c, , ) > "│► Salir                       │" }

            <<| c
            ? c == 'n' || c == 'N' { <~ 'n' }
            ? c == 's' || c == 'S' { <~ 's' }
            ? c == 'q' || c == 'Q' { <~ 's' }
            ? c == '\n' {
                ?  ==  { <~ 'n' }
                ?  ==  { <~ 's' }
            }
             = __(c, , )
        }
    }

    // ──   —   ───────────────────────────────────────
    // _  =    _ ( ).
    //        =    .
    // _   =   .
    //      = [(, c, , )] .
    // _*  =   —   
    _(, _, _,
             , _, , _, ,
             , _,
             _, __,
             _, __,
             , _,
             c_c, c_c_, c_c, c_c_,
             _, , , ) {

        [, c, ] = 

        // ──  ─────────────────────────────────────────────────────────────
        //    
         = 
        @  <= $# {
            [, c, ] = []
            >>~ (, c, , ) > " "
            ++
        }
        //    
         = 
        @  <= _$# {
            [, c, ] = _[]
            >>~ (, c, , ) > " "
            ++
        }
        //   —   
         = 
        @  <= $# {
            [, c, , ] = []
            >>~ (, c, , _c_()) > __(, )
            ++
        }
        //  c:  ,  
        ? _ {
            [, c, _] = _
             = 
            @  <= _$# {
                [, c, , ] = _[]
                >>~ (, c, , ) > " "
                ++
            }
             = 
            @  <= $# {
                [, c, , ] = []
                >>~ (, c, , _c_()) > __(, )
                ++
            }
        }

        // ──   ─────────────────────────────────────────────────────
         = 
        @  <= _$# {
            [, c, , , c] = _[]
            >>~ (, c, , ) > " "
            ++
        }
         = 
        @  <= $# {
            [, c, , , c] = []
            >>~ (, c, , ) > "▼"
            ++
        }

        // ──  D ─────────────────────────────────────────────────────────────
         = 
        @  <= _$# {
            [, c] = _[]
            >>~ (, c, , ) > " "
            ++
        }
         = 
        @  <= $# {
            [, c] = []
            >>~ (, c, , ) > "|"
            ++
        }

        // ──  (^ ) ────────────────────────────────────────────────────
         = 
        @  <= __$# {
            [, c] = __[]
            >>~ (, c, , ) > " "
            ++
        }
         = 
        @  <= _$# {
            [, c] = _[]
            >>~ (, c, , ) > "^"
            ++
        }

        // ──   ──────────────────────────────────────────────────────
         = 
        @  <= __$# {
            [, c] = __[]
            >>~ (, c, , ) > " "
            ++
        }
         = 
        @  <= _$# {
            [, c] = _[]
            >>~ (, c, , ) > "·"
            ++
        }

        // ──  (   ) ─────────────────────────
        ? _ <>  {
            >>~ (_, _, , ) > " "
        }
        ? _ <>  || c_c <> c_c_ || c_c <> c_c_ {
            >>~ (_, , , _c_(c_c)) > "▲"
        }

        // ──   (  ) ────────────────────────────
        ? c_c <> c_c_ || c_c <> c_c_ {
            c_(c_c, c_c, , )
        }
    }

    // ── _ — 选择 idioma/language/Hol (=pIqaD =English =Español) ─────────────
    _(, ) {
        >>!
        _c =  /  - 
        c_c  =  /  - 
         = 

        @:_ {
            >>~ (_c,    c_c, , ) > "╭──────────────────────────────────╮"
            >>~ (_c+,  c_c, , ) > "│                         │"
            >>~ (_c+,  c_c, , ) > "│                       │"
            >>~ (_c+,  c_c, ,  ) > "├──────────────────────────────────┤"
            >>~ (_c+,  c_c, , ) > "│   tlhIngan Hol / Language:      │"
            >>~ (_c+,  c_c, , ) > "│                                │"
            >>~ (_c+,  c_c, , ) > "│   [1]  tlhIngan (pIqaD)        │"
            >>~ (_c+,  c_c, , ) > "│   [2]  English                 │"
            >>~ (_c+,  c_c, , ) > "│   [3]  Español                 │"
            >>~ (_c+,  c_c, ,  ) > "├──────────────────────────────────┤"
            >>~ (_c+, c_c, , ) > "│  ↑↓ / 1-3 / ↵                  │"
            >>~ (_c+, c_c, , ) > "╰──────────────────────────────────╯"

            ?  ==  { >>~ (_c+, c_c, , ) > "│ ► [1]  tlhIngan (pIqaD)        │" }
            ?  ==  { >>~ (_c+, c_c, , ) > "│ ► [2]  English                 │" }
            ?  ==  { >>~ (_c+, c_c, , ) > "│ ► [3]  Español                 │" }

            <<| c
            ? c == '1' { <~  }
            ? c == '2' { <~  }
            ? c == '3' { <~  }
            ? c == 'q' || c == 'Q' { <~  }
            ? c == '\n' { <~  }
             = __(c, , )
        }
    }
}
