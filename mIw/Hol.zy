// ============================================================
// /.z:    .
//     ;  .
// ============================================================

<# ../Hol/jatlh => 
<# ../juv => 
<# ../gho => 

 = ::()
 = ::()

>> "Hov veS — i18n" ¶
>> "keys: " ($#) "   locales: " ($#) ¶
>> "" ¶

 = 

@  :  {
    ::()
     = ::(".")
     = 

    @  :  {
        ? (::()) ==  {
            ?  ==  { >> "  ["  "] "  ¶ }
            >> "      MISSING  "  ¶
             =  + 
        }
    }

    ?  ==  {
        >> "  ["  "] " (::(, )) "  " ($#) "/" ($#) "  OK" ¶
    } _ {
        >> "      → "  " missing" ¶
    }

     =  + 
}

//    :   ,  ASCII .
>> "" ¶
>> "composed" ¶
@  :  {
    ::()
    >> "  ["  "] " (::()) " · " (::()) " · " (::()) ¶
    >> "        " (::()) ¶
    >> "        " (::()) ¶
}

//      .
>> "" ¶
>> "frames" ¶
 = 
@  :  {
    ::()
     = [
        . $+ ::("."),
        .,
        ::("."),
        ::_(, ::("."), #),
        ::_(, ::("."), #)
    ]
     = ::(, )
     = ::([])
    @  :  {
        >> "  "  ¶
        ? (::()) <>  {
            >> "      RAGGED  " (::()) " ≠ "  ¶
             =  + 
        }
    }
    >> "" ¶
}

//   : d   ;  .
>> "rotation" ¶
 = 
::([])
@  : ..($#) {
    ? (::()) <> [] {
        >> "      DRIFT  " (::()) " != " [] ¶
         =  + 
    }
    >> "  " (::()) "  " (::(".")) ¶
    ::()
}
? (::()) <> [] {
    >> "      NO WRAP  " (::()) " != " [] ¶
     =  + 
}

::("tlh")

>> "" ¶
?  ==  &&  ==  &&  ==  {
    >> "PASS — keys, frames and locale rotation" ¶
} _ {
    >> "FAIL — "  " missing, "  " ragged rows, "  " rotation faults" ¶
}
