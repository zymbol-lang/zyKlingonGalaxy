//  ( ) — x- c       (C  —   )
//   (): ' --   
//
//      (C ).
//  c     (   ).
//
// C:
//   ← /                  → /       
//   c        ( c,  )
//   ↑             ( ,   ; -c c  )
//   ↓            (    —   )
//              /                
//
// : c  &&   ..//_.

<# ./Duj  =>     //   
<# ./jagh =>     //   
<# ./bach => c    // c 
<# ./HUD  =>     //  

//   ;    (  )
[, c] = >>?
        = c  -     //  
        =  -     //  
_  =  +        //       
_ = 
_c  = c

//      c —  xc  c
_  = <\ "date +%N" \>
_ = <\ "echo $$" \>
_ = <\ "od -An -N2 -tu2 /dev/urandom | tr -d ' \n'" \>
  = (#|_| + #|_| *  + #|_| * ) % 

>>| {
    // Sel_Hol fija el idioma en Hol/jatlh y ahí se queda: el
    // estado del módulo se comparte por ruta de archivo, así que
    // ningún dibujo necesita recibirlo.
    //
    // EN: Sel_Hol sets the locale in Hol/jatlh and it stays there —
    // module state is shared per file path, so no render call needs
    // to be handed it.
    ::_(, )
    @: {                                   // :  c 
         = ::_(, )       //  c + c → /c

            =  /  +     //  c: c
         =              //  ()
            =              // c
            =              //  

        @:_ {                           // :  
            [, ]  = ::_(, , , )
                    = []     // c  
                    = []     //   
            _    = []     //   
            _  = []     //   
                  = #    // #      
            _     = #    // #     
            __ =    //    c  
            _c   =    // c  x  
            c_c  = #  //  /
            c_c   =    //   (  )

            ::_(, )
            ::_(, , )
            ::_(, )
            ::_(, )
            ::c_(c_c, c_c, )
            ::_(, , )
            ::_(, _, , c_c)

            @: {                           // :  c (~ )
                <<|? c
                @: {
                    <<|? 
                    ?  == '\0' { @:! }
                    c = 
                    @:>
                }

                //   —  c  c
                [_c, c_c] = >>?
                ? _c <> _ || c_c <> _c {
                            = c_c - 
                            = _c - 
                    _  =  + 
                    _ = _c
                    _c  = c_c
                    @:_>
                }

                ? c == 'q' || c == 'Q' { @:! }
                ? c == 'p' || c == 'P' {
                    ::(, )
                    ::_(, )
                    ::_(, , )
                    ::_(, )
                    ::_(, )
                    ::c_(c_c, c_c, )
                    ::_(, , )
                    ::_(, _, , c_c)
                }

                //     
                _             = 
                _           = 
                __       = _
                __     = _
                _           = 
                c_c_   = c_c
                c_c_    = c_c

                //  
                ? c == '←' || c == 'a' || c == 'A' {  = ::(, ) }
                ? c == '→' || c == 'd' || c == 'D' {  = ::(, ) }

                //   — c  (:  cc )
                ? c == ' ' {
                    ? c_c {
                        c_c  = #
                        __ = 
                    }
                    ? ! {
                           = c::(, _ - , )
                         = #
                    }
                }

                // rapid fire — burst of 4 (20ms apart); 3s cooldown
                ? c == '↑' && __ ==  && _c ==  {
                    ? c_c { c_c = # }
                    __ = 
                    @: {
                        ? __ ==  { @:! }
                        _      = c::(_, _ - , )
                        __ = __ - 
                        @~ 
                        @:>
                    }
                    _c = ### ( / )
                }
                ? _c >  { _c = _c -  }

                // : ↓ c (cc ); ↓   c
                // Cc  —      -
                ? c == '↓' && !c_c_ && c_c >  {
                    c_c  = #
                    __ = 
                }
                ? c == '↓' && c_c_ { c_c = # }

                // c  ; c  +  
                [, , , , , ] = c::_(, , , , )
                 =  + 

                // c  ; c - 
                [_, _, , , _, ] = c::__(_, , , )
                 =  + _

                ?  + _ >  { ::_(, ) }

                //     —        c
                __ = 
                // c     
                [, , , _] = ::_(, , , , , , )

                //   c;  c  
                [_, ] = c::_(_, , , , , )

                // c  ;    c
                [_, _, c_c, c_c] = c::__(_, , _, , , c_c, c_c)

                // c -c   
                _ = ::_(, , _)

                ? _ || _ {
                     =  - 
                    ::_(, _, , )
                    ?  >  {
                                    =  /  + 
                                  = []
                        _      = []
                        _    = []
                                = #
                        __ = 
                        _c   = 
                        c_c  = #
                        c_c   = 
                        ::_(, , )
                        ::c_(c_c, c_c, )
                        ::_(, _, , c_c)
                    }
                }

                _ = ::_(, )
                ? _ ||  ==  { @:! }

                //   —   c
                ::_(, _, _,
                              , __, , _, ,
                              , _,
                              _, __,
                              _, __,
                              , _,
                              c_c, c_c_, c_c, c_c_,
                              _, , )
                @~ 
            }

            ? !_ { @:_! }    //     c →  

             =  + 
            ::_( - , , , )
        }

        //   —  c
        °  += 
        °_ = °_$+ 

        cc = ::_(, , , _, , )
        ? cc == 's' { @:! }
    }
}
