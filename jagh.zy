//  () —     veS  (CSUR PUA —   )
// Galaxian , choH je  .
//
//   (-tlhegh):
//   [] = vel       choH   (+ lam / - poS)
//   [] =        choH; DRIFT_TICKS 
//   [] = enemigos  [(fila, col, , hp), ...]    
//
//  :   =    ( , rows -, hp=)
//                =    ( , rows -, hp=)
//                =  ( , row ,    hp=)
//
//  : (, c, , _, _c, _, _c)
//   _  = cd;  =   .   .
//    :   ,   ,   .

# jagh {
    #> { _, _, _, _ }

// LCG (Numerical Recipes): constants  serpiente/logica.zy
    _c() {
        <~ ( *  + ) % 
    }

    //  integer in [, ]; <~ (val, next_seed)
    _(, , ) {
         = _c()
        <~ ( % ( -  + ) + , )
    }

    // Single pass over : <~ (min_col, max_col)
    // <~ (, )   naQ — choH  .
    _c_() {
        ? $# ==  { <~ (, ) }
        [, , , ] = []
         = 
          = 
        @:c_ {
            ?  > $# { @:c_! }
            [, c, , ] = []
            ? c <  {  = c }
            ? c >  {  = c }
             =  + 
        }
        <~ (, )
    }

    //       Daq
    __(, ) {
         = []
         = 
        @:_ {
            ?  > $# { @:_! }
            ?  <>  {  =  $+ [] }
             =  + 
        }
        <~ 
    }

    //    : row  →  (), rows - →  (), rows - →  ()
    __() {
        ?  ==  { <~  }
        ?  <=  { <~  }
        <~ 
    }

//  choH vel Daq  (  Daq)
    __c_(c, ) {
        ? c <  { <~  }
        ? c >  { <~ - }
        <~ 
    }

//  Hap  ;  +.
    // <~ (, , )
    _c_(, , , , ) {
        ? $# ==  { <~ (, , ) }
        [, ] = _(, , $#)
        [, c, , ] = []
        c       = __c_(c, )
            =  $+ (, c, , , c, , c)
         = __(, )
        <~ (, , )
    }

    // ─────────────────────────────────────────────────────────────────────────
// API 
    // ─────────────────────────────────────────────────────────────────────────

    //  chu'  .
    //  rows ×  col, -char spacing,  .
    // <~ (, )
    _(, , , ) {
        _ = 
             = 
        c_  =  /  - (_ * ) /  + 
        ? c_ <  { c_ =  }

         = []
         = 
        @:_ {
            ?  >  { @:_! }
             = __()
            c = c_
            @:c_ {
                ? c > c_ + (_ - ) *  { @:c_! }
                 =  $+ (, c, ,  + )
                c = c + 
            }
             =  + 
        }
         = (, , )    // =+ (right), c=
        <~ (, )
    }

//  je    DaH.
    //
    // choH : _ c  choH  c Daq  Dung.
//      choH:  choH   Qa'
    //    (cols –+),   .
    //
//  :    Hap; MAX_DIVERS 
    //    (MAX_DIVERS +   ).
    //
    // <~ (, , , _)
    //   _ = #  choH  DaH (  )
    _(, , , , , , ) {
        [, c, ] = 
        _ = 
        _  = #

    // ——  choH ——
        c = c + 
        ? c >= _ {
            c      = 
            _ = #

            //    choH:  Qa'
            [_c, _c] = _c_()
            ? ( == - && _c <= ) || ( ==  && _c >=  + ) {
                 =  * -
            }

             = []
             = 
            @:_ {
                ?  > $# { @:_! }
                [, c, , ] = []
                 =  $+ (, c + , , )
                 =  + 
            }
             = 
        }

        //  : cd  .
        _ = []
         = #
         = 
        @:_ {
            ?  > $# { @:_! }
            [, c, , , c, , c] = []
             = #

            //  :    .
            ? _ { c = c +  }

            // cd:  c   ,  .
            ?  ==  {
                ? c %  ==  { c = __c_(c, ) }
                 =  + 
                c = c + c
                ? c <  { c =  }
                ? c >  +  { c =  +  }
            }

            // :    .
            ?  ==  { c = c + c }

            //  :   ,   .
            ?  ==  &&  >  +  {
                 = 
                  = 
                ? c <=  /  {
                    c  = 
                    c = 
                }
                ? c >  /  {
                    c  =  + 
                    c = -
                }
            }

            //   :   .
            ?  ==  && c ==   && c >= c {  = # }
            ?  ==  && c == - && c <= c {  = # }

            ?  {  =  $+ (, c, ,  + ) }
            ? ! { _ = _ $+ (, c, , , c, , c) }
             =  + 
        }
         = _

        // ——   chu' ——
        c =  + 
        ? c >  { c =  }
        ? $# < c && $# >  {
            [, ] = _(, , )
            ?  <=  +  {
                [, , ] = _c_(, , , , )
            }
        }

         = (, c, )
        <~ (, , , _)
    }

    //   :  .     .
    _(, , _) {
         = #
         = []
         = 
        @:_ {
            ?  > $# { @:_! }
            [, c, , , c, , c] = []
            ?  == _ && c ==  {  = # }
            ?  <> _ || c <>  {  =  $+ [] }
             =  + 
        }
        <~ (, )
    }

    // <~ #  je  .
    _(, ) {
        [, c, ] = 
        <~ $# ==  && $# == 
    }
}
