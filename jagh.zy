//  () —     veS  (CSUR PUA —   )
// Galaxian , choH je  .
//
//   (3-tlhegh):
//   [1] = vel       choH   (+1 lam / -1 poS)
//   [2] =        choH; DRIFT_TICKS 
//   [3] = enemigos  [(fila, col, , hp), ...]    
//
//  :  0 =    ( , rows 5-6, hp=1)
//               1 =    ( , rows 3-4, hp=2)
//               2 =  ( , row 2,    hp=3)
//
//  : (fila, col, , vel_fila, vel_col) —  HP  (1-shot )
//     ,   ,  .
//        Daq (.zy).

# jagh {
    #> { _, _, _, _ }

// LCG (Numerical Recipes): constants  serpiente/logica.zy
    _c() {
        <~ ( *  + ) % 
    }

    //  integer in [, ]; <~ (val, next_seed)
    _(, , ) {
         = _c()
        <~ ( % ( -  + ) + , )
    }

    // Single pass over : <~ (min_col, max_col)
    // <~ (, )   naQ — choH  .
    _c_() {
        ? $# ==  { <~ (, ) }
        [, , , ] = []
         = 
          = 
        @:c_ {
            ?  > $# { @:c_! }
            [, c, , ] = []
            ? c <  {  = c }
            ? c >  {  = c }
             =  + 
        }
        <~ (, )
    }

    //       Daq
    __(, ) {
         = []
         = 
        @:_ {
            ?  > $# { @:_! }
            ?  <>  {  =  $+ [] }
             =  + 
        }
        <~ 
    }

    //    : row  →  (), rows - →  (), rows - →  ()
    __() {
        ?  ==  { <~  }
        ?  <=  { <~  }
        <~ 
    }

//  choH vel Daq  (  Daq)
    __c_(c, ) {
        ? c <  { <~  }
        ? c >  { <~ - }
        <~ 
    }

//  Hap  ;  +.
    // <~ (, , )
    _c_(, , , , ) {
        ? $# ==  { <~ (, , ) }
        [, ] = _(, , $#)
        [, c, , ] = []
        c       = __c_(c, )
            =  $+ (, c, , , c)
         = __(, )
        <~ (, , )
    }

    // ─────────────────────────────────────────────────────────────────────────
// API 
    // ─────────────────────────────────────────────────────────────────────────

    //  chu'  .
    //  rows ×  col, -char spacing,  .
    // <~ (, )
    _(, , , ) {
        _ = 
             = 
        c_  =  /  - (_ * ) /  + 
        ? c_ <  { c_ =  }

         = []
         = 
        @:_ {
            ?  >  { @:_! }
             = __()
            c = c_
            @:c_ {
                ? c > c_ + (_ - ) *  { @:c_! }
                 =  $+ (, c, ,  + )
                c = c + 
            }
             =  + 
        }
         = (, , )    // =+ (right), c=
        <~ (, )
    }

//  je    DaH.
    //
    // choH : _ c  choH  c Daq  Dung.
//      choH:  choH   Qa'
    //    (cols –+),   .
    //
//  :    Hap; MAX_DIVERS 
    //    (MAX_DIVERS +   ).
    //
    // <~ (, , , _)
    //   _ = #  choH  DaH (  )
    _(, , , , , , ) {
        [, c, ] = 
        _ = 
        _  = #

    // ——  choH ——
        c = c + 
        ? c >= _ {
            c      = 
            _ = #

            //    choH:  Qa'
            [_c, _c] = _c_()
            ? ( == - && _c <= ) || ( ==  && _c >=  + ) {
                 =  * -
            }

             = []
             = 
            @:_ {
                ?  > $# { @:_! }
                [, c, , ] = []
                 =  $+ (, c + , , )
                 =  + 
            }
             = 
        }

        // ——   ;  Daq ——
        _ = []
         = 
        @:_ {
            ?  > $# { @:_! }
            [, c, , , c] = []
             =  + 
            c = c + c
            ?  <=  +  && c >=  && c <=  +  {
                _ = _ $+ (, c, , , c)
            }
             =  + 
        }
         = _

        // ——   chu' ——
        c =  + 
        ? c >  { c =  }
        ? $# < c && $# >  {
            [, ] = _(, , )
            ?  <=  +  {
                [, , ] = _c_(, , , , )
            }
        }

         = (, c, )
        <~ (, , , _)
    }

    // <~ #    ' Daq.
    _(, , _) {
         = 
        @:_ {
            ?  > $# { @:_! }
            [, c, , , c] = []
            ?  == _ && c ==  { <~ # }
             =  + 
        }
        <~ #
    }

    // <~ #  je  .
    _(, ) {
        [, c, ] = 
        <~ $# ==  && $# == 
    }
}
