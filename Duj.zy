//  () —  choH   veS  (CSUR PUA —   )
// B'rel  choH  QeH.
//  col  Daq;  cols  — AN+1.

#  {
    #> { ,  }

    //   poS; clamp ().
    (, ) {
        ?  >  { <~  -  }
        <~ 
    }

    //   lam; clamp (+).
    (, ) {
        ?  <  +  { <~  +  }
        <~ 
    }
}
