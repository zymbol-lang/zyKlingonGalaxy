//  () —      (CSUR PUA —   )
// >>~   —  , <~ 
//  _ (<~ )  _ (<~ 'n'/'s')
//
// ANSI 256  :
//   =8  =15  =46  _=51  =51  _=226
//   =214  =208  =220  =196  =196  =226
//   =11  =10  =14  =51

# HuD {

    <# ./Hol/jatlh => 
    <# ./juv => 
    <# ./gho => 
    #> {
        _,
        _, _, _, _, c_,
        _, _,
        , _, _, _,
        _, _
    }

    __() {
        <~ "─" $* 
    }

    //   HP —  
    __(, ) {
        ?  ==  { ?  >=  { <~ "◆" } <~ "◇" }
        ?  ==  { ?  >=  { <~ "▼" } <~ "△" }
        <~ "▽"
    }

    //   — 
    _c_() {
        ?  ==  { <~  }
        ?  ==  { <~  }
        <~ 
    }



    //  :  → ,  → 
    _c_(c_c) {
        ? c_c { <~  }
        <~ 
    }

    __(c, , ) {
        ? c == '↑' { ?  >    { <~  -  } <~  }
        ? c == '↓' { ?  <  { <~  +  } <~    }
        <~ 
    }

    // ── gho SeH ─────────────────────────────────────────────────────
    // Dibuja las filas de un marco ya construido desde (, c).
    //  va en paralelo a : un color ANSI por fila.
    //
    // EN: Draw the rows of a built frame from (, c).
    //  runs parallel to , one ANSI index per row.
    _(, , , c) {
         = 1
        @  <= ($#) {
            >>~ ( +  - 1, c, 0, []) > []
            ++
        }
    }

    // Centra un marco dentro del tablero y devuelve su esquina
    // superior izquierda.
    // EN: Centre a frame inside the board; return its top-left corner.
    _(, , ) {
         = ::([1])
         = $#
        <~ (2 + ( - ) / 2, 2 + ( - ) / 2)
    }

    //  copias del color c, para los marcos de un solo color.
    // EN:  copies of colour c, for single-colour frames.
    __(, c) {
         = []
         = 1
        @  <=  {
             =  $+ c
            ++
        }
        <~ 
    }

    // Una insignia centrada sobre una fila del borde, entre corchetes.
    // Se mide: antes se colocaba con desplazamientos constantes
    // derivados de la longitud de la palabra klingon.
    //
    // EN: A badge centred on a border row, in brackets. It is
    // measured; it used to be placed with constants derived from the
    // length of the Klingon word.
    __(, c, ) {
         = ::()
        >>~ (1, c - 1, 0, 8) > "┤"
        >>~ (1, c, 0, ) > 
        >>~ (1, c + , 0, 8) > "├"
    }

    // Menú de dificultad — devuelve el retardo en ms, o 0 para salir.
    //
    // El menú es datos: cuatro etiquetas traducidas y sus retardos.
    // Antes eran veinticuatro líneas de dibujo —cuatro opciones ×
    // tres idiomas × dos estados— con el relleno tecleado a mano.
    //
    // EN: Difficulty menu — returns the delay in ms, or 0 to quit.
    // The menu is data: four translated labels and their delays. It
    // used to be twenty-four draw lines (four options × three
    // languages × two states) with the padding typed by hand.
    _(, ) {
        >>!
         = 2
         = [120, 90, 60, 40]

        @:_ {
             = [
                ::("."),
                ::("."),
                ::("."),
                ::(".")
            ]

             = [
                . $+ "H O V   V E S",
                . $+ ::("."),
                . $+ ::("."),
                .,
                ::("."),
                ""
            ]
            // El ancho de la columna de etiquetas también se mide. Con
            // la constante 26 que tenía, "Hab SoSlI' (medium)" se
            // comía el espacio y el número se le pegaba encima. Se
            // mide con la marca de selección puesta, para que la fila
            // no se mueva al mover el cursor.
            //
            // EN: The label column is measured too. With the constant
            // 26 it had, "Hab SoSlI' (medium)" ran into the number.
            // Measured with the selection marker on, so the row does
            // not move when the cursor does.
            _ = 0
             = 1
            @  <= 4 {
                 = ::(::_(, [], #1))
                ?  > _ { _ =  }
                ++
            }
            _ = _ + 2

             = 1
            @  <= 4 {
                 = ::_(, [],  == )
                 = []
                 =  $+ (::(, _) $++  " ms")
                ++
            }
             =  $+ .
             =  $+ ::(".")
             =  $+ ::(".")
            // El idioma también se cambia desde aquí, no solo en la
            // primera pantalla. Sel_Hol se ve una vez por sesión.
            // EN: The language can be changed here too, not only on
            // the first screen — Sel_Hol is seen once per session.
             =  $+ ("L = " $+ ::(".") $+ ": " $+ ::("."))

             = ::(, 3)
             = [14, 14, 220, 14, 8, 15, 15]
             = 1
            @  <= 4 {
                c = 15
                ?  ==  { c = 46 }
                 =  $+ c
                ++
            }
             =  $+ 8 $+ 25 $+ 25 $+ 220 $+ 14

            [, c] = _(, , )
            _(, , , c)

            <<| c
            ? c == 'l' || c == 'L' {
                ::()
                >>!
            }
            ? c == '1' { <~ [1] }
            ? c == '2' { <~ [2] }
            ? c == '3' { <~ [3] }
            ? c == '4' { <~ [4] }
            ? c == 'q' || c == 'Q' { <~ 0 }
            ? c == '\n' { <~ [] }
             = __(c, , 4)
        }
    }

    // ──   +  ─────────────────────────────────────────────────
    _(, ) {
        >>!
        >>~ (,      , , ) > "╭" __() "╮"
        >>~ ( + , , , ) > "╰" __() "╯"
         = 
        @  <=  +  {
            >>~ (, ,      , ) > "│"
            >>~ (,  + , , ) > "│"
            ++
        }
    }

    // ── yIH HeH ─────────────────────────────────────────────────────
    _(, , ) {
        c_ = 3
         = ::(".") $+ ": "
         = ::()
        >>~ (1, c_, 0, 10) > 
        @ :1..3 {
            ?  <=  { >>~ (1, c_ +  + ( - 1) * 2, 0, 10) > "♦" }
            ?  >   { >>~ (1, c_ +  + ( - 1) * 2, 0,  8) > "·" }
        }
    }

    // ── botjan HoS HeH ───────────────────────────────────────────────
    // La etiqueta es la inicial de la palabra traducida más ":", que
    // es lo que hacían a mano las tres ramas de idioma (H: / S: / E:).
    // Se recorta por columnas, no por grafemas.
    //
    // EN: The label is the initial of the translated word plus ":",
    // which is what the three language branches did by hand
    // (H: / S: / E:). Truncated by columns, not by graphemes.
    c_(c_c, c_c, ) {
        c_ = 19
        c_ = 8
        ? c_c { c_ = 51 }
         = ::(::("."), 1) $+ ":"
         = ::()
        >>~ (1, c_, 0, c_) > 
        @ :1..3 {
            ?  <= c_c { >>~ (1, c_ +  + , 0, 51) > "■" }
            ?  >  c_c { >>~ (1, c_ +  + , 0,  8) > "·" }
        }
    }

    // ── nob HeH ─────────────────────────────────────────────────────
    _(, ) {
         = " " $+ ::(".") $+ ": " $+ ::() $+ " "
        __(,  / 2 - ::() / 2 + 1, 11)
    }

    // ── HoS HeH ─────────────────────────────────────────────────────
    _(, ) {
         = " " $+ ::(".") $+ ": " $+ ::() $+ " "
        __(,  - ::() - 1, 14)
    }

    // ──    ────────────────────────────────────────────
    _(, , ) {
        [, c, ] = 
         = 
        @  <= $# {
            [, c, , ] = []
            >>~ (, c, , _c_()) > __(, )
            ++
        }
    }

    // ──   ─────────────────────────────────────────────────────────
    _(, _, , c_c) {
        >>~ (_, , , _c_(c_c)) > "▲"
    }

    // ── yot jIH ───────────────────────────────────────────────────────────
    (, ) {
         = [
            "",
            . $+ ::("."),
            . $+ "(" $+ ::(".") $+ ")",
            "",
            "  [P]  " $+ ::(".")
        ]
         = ::(, 2)
         = __($#, 14)
        [, c] = _(, , )
        _(, , , c)

        @:_ {
            <<| c
            ? c == 'p' || c == 'P' { @:_! }
        }
    }

    // ──   () ─────────────────────────────────────────────
    _(, _, , ) {
        @ :1..3 {
            >>~ (_, , , ) > "✸"
            @~ 
            >>~ (_, , , ) > " "
            @~ 
        }
    }

    // ── HoS Qaw' jIH ──────────────────────────────────────────────────
    _(, , , ) {
         = [
            . $+ ::("."),
            .,
            ::(),
            ::(".") $+ ": " $+ ::()
        ]
         = ::(, 3)
         = [46, 46, 8, 15, 11, 46]
        [, c] = _(, , )
        _(, , , c)
        @~ 1800
    }

    // ── Quj Hegh menu — <~ 'n' Quj chu', 's' mej ────────
    _(, , , _, , ) {
         = 1

        @:_ {
            >>!
             = [
                ::("."),
                ::(".")
            ]

             = [
                . $+ ::("."),
                . $+ "(" $+ ::(".") $+ ")",
                .,
                ::(".") $+ ": " $+ ::(),
                ::(".") $+ ": " $+ ::(),
                ::(".") $+ ": " $+ ::(),
                .
            ]
             = 1
            @  <= 2 {
                 = "  "
                ?  ==  {  = "► " }
                 =  $+ ( $+ [])
                ++
            }

             = ::(, 2)
             = [196, 196, 196, 8, 15, 15, 15, 8]
             = 1
            @  <= 2 {
                c = 15
                ?  ==  { c = 46 }
                 =  $+ c
                ++
            }
             =  $+ 14

            [, c] = _(, , )
            _(, , , c)

            <<| c
            ? c == 'n' || c == 'N' { <~ 'n' }
            ? c == 's' || c == 'S' { <~ 's' }
            ? c == 'l' || c == 'L' { ::() }
            ? c == 'q' || c == 'Q' { <~ 's' }
            ? c == '\n' {
                ?  == 1 { <~ 'n' }
                ?  == 2 { <~ 's' }
            }
             = __(c, , 2)
        }
    }

    // ──   —   ───────────────────────────────────────
    // _  =    _ ( ).
    //        =    .
    // _   =   .
    //      = [(, c, , )] .
    // _*  =   —   
    _(, _, _,
             , _, , _, ,
             , _,
             _, __,
             _, __,
             , _,
             c_c, c_c_, c_c, c_c_,
             _, , ) {

        [, c, ] = 

        // ──  ─────────────────────────────────────────────────────────────
        //    
         = 
        @  <= $# {
            [, c, ] = []
            >>~ (, c, , ) > " "
            ++
        }
        //    
         = 
        @  <= _$# {
            [, c, ] = _[]
            >>~ (, c, , ) > " "
            ++
        }
        //   —   
         = 
        @  <= $# {
            [, c, , ] = []
            >>~ (, c, , _c_()) > __(, )
            ++
        }
        //  c:  ,  
        ? _ {
            [, c, _] = _
             = 
            @  <= _$# {
                [, c, , ] = _[]
                >>~ (, c, , ) > " "
                ++
            }
             = 
            @  <= $# {
                [, c, , ] = []
                >>~ (, c, , _c_()) > __(, )
                ++
            }
        }

        // ──   ─────────────────────────────────────────────────────
         = 
        @  <= _$# {
            [, c, , , c] = _[]
            >>~ (, c, , ) > " "
            ++
        }
         = 
        @  <= $# {
            [, c, , , c] = []
            >>~ (, c, , ) > "▼"
            ++
        }

        // ──  D ─────────────────────────────────────────────────────────────
         = 
        @  <= _$# {
            [, c] = _[]
            >>~ (, c, , ) > " "
            ++
        }
         = 
        @  <= $# {
            [, c] = []
            >>~ (, c, , ) > "|"
            ++
        }

        // ──  (^ ) ────────────────────────────────────────────────────
         = 
        @  <= __$# {
            [, c] = __[]
            >>~ (, c, , ) > " "
            ++
        }
         = 
        @  <= _$# {
            [, c] = _[]
            >>~ (, c, , ) > "^"
            ++
        }

        // ──   ──────────────────────────────────────────────────────
         = 
        @  <= __$# {
            [, c] = __[]
            >>~ (, c, , ) > " "
            ++
        }
         = 
        @  <= _$# {
            [, c] = _[]
            >>~ (, c, , ) > "·"
            ++
        }

        // ──  (   ) ─────────────────────────
        ? _ <>  {
            >>~ (_, _, , ) > " "
        }
        ? _ <>  || c_c <> c_c_ || c_c <> c_c_ {
            >>~ (_, , , _c_(c_c)) > "▲"
        }

        // ──   (  ) ────────────────────────────
        ? c_c <> c_c_ || c_c <> c_c_ {
            c_(c_c, c_c, )
        }
    }

    // ── Sel_Hol — elige el idioma y lo deja fijado en Hol/jatlh ──────
    //
    // Devuelve el código ISO 639 elegido, pero lo importante es el
    // efecto: llama a Hol::cher. A partir de ahí ninguna función de
    // dibujo necesita saber qué idioma está activo, porque el estado
    // vive en el módulo y se comparte por ruta de archivo.
    //
    // Los nombres de los idiomas salen de cada idioma, no del actual:
    // «Español» se escribe igual esté el juego en klingon o en
    // inglés, que es la única forma de que un menú de idiomas sirva
    // a quien no entiende el idioma en curso.
    //
    // EN: Pick the language and leave it set in Hol/jatlh. It returns
    // the ISO 639 code, but the point is the side effect: from here
    // on no render function needs to know which locale is active.
    // The language names come from each locale, not from the current
    // one — the only way a language menu is any use to someone who
    // cannot read the language it is currently in.
    _(, ) {
        >>!
         = ::()
         = ::()
         = 1

         = []
        @  :  {
            ::()
             =  $+ ::(".")
        }
        ::()

        @:__ {
             = [
                . $+ "H O V   V E S",
                . $+ ::("."),
                .,
                ::(".") $+ ":",
                ""
            ]
             = 1
            @  <= ($#) {
                 =  $+ ::_(, [],  == )
                ++
            }
             =  $+ .
             =  $+ "↑↓ / 1-3 / ↵"

             = ::(, 3)
             = [20, 20, 220, 8, 21, 20]
             = 1
            @  <= ($#) {
                c = 20
                ?  ==  { c = 46 }
                 =  $+ c
                ++
            }
             =  $+ 8 $+ 20 $+ 20

            [, c] = _(, , )
            _(, , , c)

            <<| c
            ? c == '1' { ::([1]) <~ [1] }
            ? c == '2' { ::([2]) <~ [2] }
            ? c == '3' { ::([3]) <~ [3] }
            ? c == 'q' || c == 'Q' { ::([1]) <~ [1] }
            ? c == '\n' { ::([]) <~ [] }
             = __(c, , $#)
        }
    }
}
