//  () —      (CSUR PUA —   )
// >>~   —  , <~ 
//  _ (<~ )  _ (<~ 'n'/'s')
//
// ANSI 256  :
//   =  =  =  _=  =  _=
//   =  =  =  =  =  =
//   =  =  =  =

# HuD {

    <# ./Hol/jatlh => 
    <# ./juv => 
    <# ./gho => 
    #> {
        _,
        _, _, _, _, c_,
        _, _,
        , _, _, _,
        _, _
    }

    __() {
        <~ "─" $* 
    }

    //   HP —  
    __(, ) {
        ?  ==  { ?  >=  { <~ "◆" } <~ "◇" }
        ?  ==  { ?  >=  { <~ "▼" } <~ "△" }
        <~ "▽"
    }

    //   — 
    _c_() {
        ?  ==  { <~  }
        ?  ==  { <~  }
        <~ 
    }



    //  :  → ,  → 
    _c_(c_c) {
        ? c_c { <~  }
        <~ 
    }

    __(c, , ) {
        ? c == '↑' { ?  >    { <~  -  } <~  }
        ? c == '↓' { ?  <  { <~  +  } <~    }
        <~ 
    }

    // ── gho SeH ──
    //    ;   .
    _(, , , c) {
         = 
        @  <= ($#) {
            >>~ ( +  - , c, , []) > []
            ++
        }
    }

    //   ;   .
    _(, , ) {
         = ::([])
         = $#
        <~ ( + ( - ) / ,  + ( - ) / )
    }

    //  c   .
    __(, c) {
         = []
         = 
        @  <=  {
             =  $+ c
            ++
        }
        <~ 
    }

    //   ;  , .
    __(, c, ) {
         = ::()
        >>~ (, c - , , ) > "┤"
        >>~ (, c, , ) > 
        >>~ (, c + , , ) > "├"
    }

    //  :  ,   .  , .
    _(, ) {
        >>!
         = 
         = [, , , ]

        @:_ {
             = [
                ::("."),
                ::("."),
                ::("."),
                ::(".")
            ]

             = [
                . $+ "H O V   V E S",
                . $+ ::("."),
                . $+ ::("."),
                .,
                ::("."),
                ""
            ]
            //    ;  .
            _ = 
             = 
            @  <=  {
                 = ::(::_(, [], #))
                ?  > _ { _ =  }
                ++
            }
            _ = _ + 

             = 
            @  <=  {
                 = ::_(, [],  == )
                 = []
                 =  $+ (::(, _) $++ ::() " ms")
                ++
            }
             =  $+ .
             =  $+ ::(".")
             =  $+ ::(".")
            //     .
             =  $+ ("L = " $+ ::(".") $+ ": " $+ ::("."))

             = ::(, )
             = [, , , , , , ]
             = 
            @  <=  {
                c = 
                ?  ==  { c =  }
                 =  $+ c
                ++
            }
             =  $+  $+  $+  $+  $+ 

            (, c) = _(, , )
            _(, , , c)

            <<| c
            ? c == 'l' || c == 'L' {
                ::()
                >>!
            }
            ? c == '1' { <~ [] }
            ? c == '2' { <~ [] }
            ? c == '3' { <~ [] }
            ? c == '4' { <~ [] }
            ? c == 'q' || c == 'Q' { <~  }
            ? c == '\n' { <~ [] }
             = __(c, , )
        }
    }

    // ──   +  ─────────────────────────────────────────────────
    _(, ) {
        >>!
        >>~ (,      , , ) > "╭" __() "╮"
        >>~ ( + , , , ) > "╰" __() "╯"
         = 
        @  <=  +  {
            >>~ (, ,      , ) > "│"
            >>~ (,  + , , ) > "│"
            ++
        }
    }

    // ── yIH HeH ─────────────────────────────────────────────────────
    _(, , ) {
        c_ = 
         = ::(".") $+ ": "
         = ::()
        >>~ (, c_, , ) > 
        @ :.. {
            ?  <=  { >>~ (, c_ +  + ( - ) * , , ) > "♦" }
            ?  >   { >>~ (, c_ +  + ( - ) * , ,  ) > "·" }
        }
    }

    // ── botjan HoS HeH ───────────────────────────────────────────────
    // :   ":";  ,  .
    c_(c_c, c_c, ) {
        c_ = 
        c_ = 
        ? c_c { c_ =  }
         = ::(::("."), ) $+ ":"
         = ::()
        >>~ (, c_, , c_) > 
        @ :.. {
            ?  <= c_c { >>~ (, c_ +  + , , ) > "■" }
            ?  >  c_c { >>~ (, c_ +  + , ,  ) > "·" }
        }
    }

    // ── nob HeH ─────────────────────────────────────────────────────
    _(, ) {
         = " " $+ ::(".") $+ ": " $+ ::() $+ " "
        __(,  /  - ::() /  + , )
    }

    // ── HoS HeH ─────────────────────────────────────────────────────
    _(, ) {
         = " " $+ ::(".") $+ ": " $+ ::() $+ " "
        __(,  - ::() - , )
    }

    // ──    ────────────────────────────────────────────
    _(, , ) {
        (, c, ) = 
         = 
        @  <= $# {
            (, c, , ) = []
            >>~ (, c, , _c_()) > __(, )
            ++
        }
    }

    // ──   ─────────────────────────────────────────────────────────
    _(, _, , c_c) {
        >>~ (_, , , _c_(c_c)) > "▲"
    }

    // ── yot jIH ───────────────────────────────────────────────────────────
    (, ) {
         = [
            "",
            . $+ ::("."),
            . $+ "(" $+ ::(".") $+ ")",
            "",
            "  [P]  " $+ ::(".")
        ]
         = ::(, )
         = __($#, )
        (, c) = _(, , )
        _(, , , c)

        @:_ {
            <<| c
            ? c == 'p' || c == 'P' { @:_! }
        }
    }

    // ──   () ─────────────────────────────────────────────
    _(, _, , ) {
        @ :.. {
            >>~ (_, , , ) > "✸"
            @~ 
            >>~ (_, , , ) > " "
            @~ 
        }
    }

    // ── HoS Qaw' jIH ──────────────────────────────────────────────────
    _(, , , ) {
         = [
            . $+ ::("."),
            .,
            ::(),
            ::(".") $+ ": " $+ ::()
        ]
         = ::(, )
         = [, , , , , ]
        (, c) = _(, , )
        _(, , , c)
        @~ 
    }

    // ── Quj Hegh menu — <~ 'n' Quj chu', 's' mej ────────
    _(, , , _, , ) {
         = 

        @:_ {
            >>!
             = [
                ::("."),
                ::(".")
            ]

             = [
                . $+ ::("."),
                . $+ "(" $+ ::(".") $+ ")",
                .,
                ::(".") $+ ": " $+ ::(),
                ::(".") $+ ": " $+ ::(),
                ::(".") $+ ": " $+ ::(),
                .
            ]
             = 
            @  <=  {
                 = "  "
                ?  ==  {  = "► " }
                 =  $+ ( $+ [])
                ++
            }

             = ::(, )
             = [, , , , , , , ]
             = 
            @  <=  {
                c = 
                ?  ==  { c =  }
                 =  $+ c
                ++
            }
             =  $+ 

            (, c) = _(, , )
            _(, , , c)

            <<| c
            ? c == 'n' || c == 'N' { <~ 'n' }
            ? c == 's' || c == 'S' { <~ 's' }
            ? c == 'l' || c == 'L' { ::() }
            ? c == 'q' || c == 'Q' { <~ 's' }
            ? c == '\n' {
                ?  ==  { <~ 'n' }
                ?  ==  { <~ 's' }
            }
             = __(c, , )
        }
    }

    // ──   —   ───────────────────────────────────────
    // : , , ,   .
    _(, _, _,
             , _, , _, ,
             , _,
             _, __,
             _, __,
             , _,
             c_c, c_c_, c_c, c_c_,
             _, , ) {

        (, c, ) = 

        // ──  ─────────────────────────────────────────────────────────────
        //    
         = 
        @  <= $# {
            (, c, ) = []
            >>~ (, c, , ) > " "
            ++
        }
        //    
         = 
        @  <= _$# {
            (, c, ) = _[]
            >>~ (, c, , ) > " "
            ++
        }
        //   —   
         = 
        @  <= $# {
            (, c, , ) = []
            >>~ (, c, , _c_()) > __(, )
            ++
        }
        //  c:  ,  
        ? _ {
            (, c, _) = _
             = 
            @  <= _$# {
                (, c, , ) = _[]
                >>~ (, c, , ) > " "
                ++
            }
             = 
            @  <= $# {
                (, c, , ) = []
                >>~ (, c, , _c_()) > __(, )
                ++
            }
        }

        // ──   ─────────────────────────────────────────────────────
         = 
        @  <= _$# {
            (, c, , _, _c, _, _c) = _[]
            >>~ (, c, , ) > " "
            ++
        }
         = 
        @  <= $# {
            (, c, , _, _c, _, _c) = []
            >>~ (, c, , ) > "▼"
            ++
        }

        // ──  D ─────────────────────────────────────────────────────────────
         = 
        @  <= _$# {
            (, c) = _[]
            >>~ (, c, , ) > " "
            ++
        }
         = 
        @  <= $# {
            (, c) = []
            >>~ (, c, , ) > "|"
            ++
        }

        // ──  (^ ) ────────────────────────────────────────────────────
         = 
        @  <= __$# {
            (, c) = __[]
            >>~ (, c, , ) > " "
            ++
        }
         = 
        @  <= _$# {
            (, c) = _[]
            >>~ (, c, , ) > "^"
            ++
        }

        // ──   ──────────────────────────────────────────────────────
         = 
        @  <= __$# {
            (, c) = __[]
            >>~ (, c, , ) > " "
            ++
        }
         = 
        @  <= _$# {
            (, c) = _[]
            >>~ (, c, , ) > "·"
            ++
        }

        // ──  (   ) ─────────────────────────
        ? _ <>  {
            >>~ (_, _, , ) > " "
        }
        ? _ <>  || c_c <> c_c_ || c_c <> c_c_ {
            >>~ (_, , , _c_(c_c)) > "▲"
        }

        // ──   (  ) ────────────────────────────
        ? c_c <> c_c_ || c_c <> c_c_ {
            c_(c_c, c_c, )
        }
    }

    // ── Sel_Hol ──
    //  ,  .      ,
    //      .
    _(, ) {
        >>!
         = ::()
         = ::()
         = 

         = []
        @  :  {
            ::()
             =  $+ ::(".")
        }
        ::()

        @:__ {
             = [
                . $+ "H O V   V E S",
                . $+ ::("."),
                .,
                ::(".") $+ ":",
                ""
            ]
             = 
            @  <= ($#) {
                 =  $+ ::_(, [],  == )
                ++
            }
             =  $+ .
             =  $+ ("↑↓ / " $++ 1 "-" ($#) " / ↵")

             = ::(, )
             = [, , , , , ]
             = 
            @  <= ($#) {
                c = 
                ?  ==  { c =  }
                 =  $+ c
                ++
            }
             =  $+  $+  $+ 

            (, c) = _(, , )
            _(, , , c)

            <<| c
            ? c == '1' { ::([]) <~ [] }
            ? c == '2' { ::([]) <~ [] }
            ? c == '3' { ::([]) <~ [] }
            ? c == 'q' || c == 'Q' { ::([]) <~ [] }
            ? c == '\n' { ::([]) <~ [] }
             = __(c, , $#)
        }
    }
}
