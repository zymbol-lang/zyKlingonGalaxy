// ============================================================
//  ():      .
//  ;   .
// ============================================================

# gho {

    <# ./juv => 

    #> { , , , , _ }

    // :  ,    .
     := "␟"

    // :   .    .
     := "␝"

    //   .
    () {
         = 
        @  :  {
            ?  <>  {
                 = ::(())
                ?  >  {  =  }
            }
        }
        <~ 
    }

    //  , .
    () {
        ? ($#) ==  { <~  }
        ? $[..] ==  { <~ $[..] }
        <~ 
    }

    //  .  :    .
    (, ) {
         = ()
         = "─" $* ( +  * )
         = " " $* 
        _ = ["╭" $+  $+ "╮"]
        @  :  {
            ?  ==  {
                _ = _ $+ ("├" $+  $+ "┤")
            } _ {
                 = ()
                ?  <>  {
                    _ = _ $+ ("│" $+  $+ ::(, ) $+  $+ "│")
                } _ {
                    _ = _ $+ ("│" $+  $+ ::(, ) $+  $+ "│")
                }
            }
        }
        _ = _ $+ ("╰" $+  $+ "╯")
        <~ _
    }

    //  ,  .    ,  .
    //  [ ] :   , ASCII .
    _(, , ) {
         = "  "
        ?  {  = "► " }
        <~  $++ "["  "]  " 
    }
}
