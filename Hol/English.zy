// ============================================================
// Hol/English.zy — English locale (en)
// Interface contract: mu' · mI' · Qaw'mu'
// The keys are Klingon written in pIqaD; the base lives in
// Hol/tlhIngan.zy.
//
// ES: Hol/English.zy — idioma inglés (en). Las claves están en
// klingon escrito en pIqaD; la base está en Hol/tlhIngan.zy.
// ============================================================

# .Hol_English {

    #> { , ,  }

    () {
        <~ ??  {
            "."    => "English"
            "."     => "Language"

            "."     => "IKS meQtaH"
            "."     => "B'rel Bird-of-Prey vs Armada"
            "."     => "Select difficulty"
            "."     => "petaQ (easy)"
            "."    => "Hab SoSlI' (medium)"
            "."     => "Qapla' (hard)"
            "."     => "Heghlu' (death)"
            "."     => "↑↓ / 1-4 / ↵ to confirm"
            "."     => "Q = quit during game"

            "."     => "Lives"
            "."  => "Shield"
            "."     => "Score"
            "."     => "Wave"

            "."    => "PAUSED"
            "."     => "game paused"
            "."     => "resume"

            "."   => "Qapla'!"
            "."    => "Score"

            "."   => "Heghlu'!"
            "."    => "you have died"
            "."    => "Score"
            "."    => "Wave"
            "."    => "Games"
            "."   => "New game"
            "."    => "Quit"

            _                => 
        }
    }

    // English writes its digits in ASCII, so here interpolation is
    // enough — but this is still part of the contract, because the
    // Klingon locale has to rewrite every digit into the PUA and the
    // caller must not have to know which locale is active.
    //
    // ES: el inglés escribe sus cifras en ASCII, así que aquí basta
    // interpolar; sigue formando parte del contrato porque el klingon
    // tiene que reescribir cada cifra en el PUA y quien llama no debe
    // tener que saber qué idioma está activo.
    // Interpolación normal y corriente. Hasta v0.0.8 no se podía:
    // "{x}" exigía que el nombre fuera alfanumérico, y los glifos del
    // PUA son de categoría Co, así que los identificadores en pIqaD
    // —válidos en cualquier otra posición— no interpolaban. Aquí se
    // usaba $++. Corregido en el intérprete; ver hallazgos_es.md,
    // HLZ-KL-001.
    //
    // EN: Ordinary interpolation. It did not work until v0.0.8: "{x}"
    // required an alphanumeric name and PUA glyphs are category Co, so
    // pIqaD identifiers — valid in every other position — could not be
    // interpolated. This used $++ instead. Fixed in the interpreter.
    () { <~ "{}" }

    () {
        ?  == 1 { <~ "First wave cleared" }
        <~ "Wave {} cleared"
    }
}
