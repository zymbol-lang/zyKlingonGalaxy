//  ,  .  .  . .
//   program .    .
//  : "."  " " .
// ============================================================

# .Hol_tlhIngan {

    #> { ,  }

    () {
        <~ ??  {
            "."    => ""
            "."     => " "

            "."     => " "
            "."     => "    "
            "."     => " "
            "."     => ""
            "."    => " "
            "."     => ""
            "."     => ""
            "."     => "↑↓ / - / ↵ "
            "."     => "Q =  "

            "."     => ""
            "."  => ""
            "."     => ""
            "."     => ""

            "."    => ""
            "."     => " "
            "."     => ""

            "."   => ""
            "."    => ""

            "."   => ""
            "."    => ""
            "."    => ""
            "."    => ""
            "."    => ""
            "."   => " "
            "."    => ""

            _                => 
        }
    }

    () { <~ " {} " }
}
