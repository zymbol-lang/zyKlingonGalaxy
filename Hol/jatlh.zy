// ============================================================
// :    . _ d .
//     ;   (ISO 639) ASCII .
// ============================================================

# .Hol_jatlh {

    <# ./tlhIngan => 
    <# ./English => 
    <# ./Español => 

    #> {
        
        
        
        
        
        
        
        
    }

    _ = "tlh"

    // ISO 639 ;  .
    () { <~ ["tlh", "en", "es"] }

    //      :   .
    () {
        _ = 
        ??  {
            "en" => { #09# }
            "es" => { #09# }
            _    => { ## }
        }
    }
    () { <~ _ }

    //   ;  .  :  ,  .
    _() {
         = ()
         = $#
         = 
         = 
        @  <=  {
            ? [] == _ {  =  }
            ++
        }
        ?  ==  ||  ==  {  =  }
        <~ [ + ]
    }

    () { (_()) }

    () {
        ?? _ {
            "en" => { <~ ::() }
            "es" => { <~ ::() }
            _    => { <~ ::() }
        }
    }

    //    ;    .
    () { <~ "{}" }

    //   :   .
    () {
        ?? _ {
            "en" => { <~ ::() }
            "es" => { <~ ::() }
            _    => { <~ ::() }
        }
    }

    // :    ; /.z .
    () {
        <~ [
            ".", ".",

            ".", ".", ".",
            ".", ".", ".", ".",
            ".", ".",

            ".", ".", ".", ".",

            ".", ".", ".",

            ".", ".",

            ".", ".", ".",
            ".", ".", ".", "."
        ]
    }
}
